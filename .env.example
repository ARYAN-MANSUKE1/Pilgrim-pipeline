# Copy this file to ".env" and fill in real values.

# --- Gemini (translation engine) ---
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.0-flash            # override to gemini-2.5-flash etc. if you like

# --- Sarvam TTS (audio engine) ---
SARVAM_API_KEY=your_sarvam_key_here
# Optional overrides (defaults are fine to start):
# TTS_SPEAKER=anushka
# TTS_PACE=1.0
# TTS_PITCH=0.0

# --- WordPress write-back ---
WP_URL=https://allowing-lion-dev.10web.cloud
WP_USER=paanerinaik
WP_APP_PASSWORD=                          # generate in WP Admin → Users → Profile → Application Passwords

# --- Cloudflare R2 (future, not needed yet) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
